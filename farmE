-- ============================================
-- INSTANT CLAIM
-- ============================================

MainSection:NewToggle("InstantClaim", "Toggle instant claiming", function(state)

    if state then

        _G.InstantClaim = true

        task.spawn(function()

            while _G.InstantClaim do

                for _, player in ipairs(game:GetService("Players"):GetPlayers()) do

                    if not _G.InstantClaim then
                        break
                    end

                    game:GetService("ReplicatedStorage").DefinEvents.InstanceRequestFunction:InvokeServer(
                        player,
                        "CompleteBounty"
                    )

                end

                task.wait()

            end

        end)

    else

        _G.InstantClaim = false

    end

end)

