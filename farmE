-- ============================================
-- ALERT PLAYER CHECK
-- ============================================

local function IsAlertPlayer(player)

    local username = string.lower(player.Name)

    for _, name in pairs(AlertPlayers) do

        if username == string.lower(name) then
            return true
        end

    end

    return false

end

-- ============================================
-- LOUD ALARM
-- ============================================

local function PlayAlarm()

    local Sound = Instance.new("Sound")

    Sound.SoundId = "rbxassetid://9118828562"
    Sound.Volume = 10
    Sound.Looped = false
    Sound.Parent = game:GetService("SoundService")

    Sound:Play()

    task.delay(8, function()

        if Sound then
            Sound:Destroy()
        end

    end)

end

