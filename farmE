-- ============================================
-- NORMAL PLAYER JOIN NOTIFIER
-- ============================================

local Players = game:GetService("Players")

local function CreateNotification(player)

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "JoinNotifier"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = game:GetService("CoreGui")

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0, 300, 0, 90)
    Frame.Position = UDim2.new(1, -320, 1, -120)
    Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    Frame.BorderSizePixel = 0
    Frame.Parent = ScreenGui

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 10)
    Corner.Parent = Frame

    local Image = Instance.new("ImageLabel")
    Image.Size = UDim2.new(0, 70, 0, 70)
    Image.Position = UDim2.new(0, 10, 0, 10)
    Image.BackgroundTransparency = 1

    Image.Image =
        "https://www.roblox.com/headshot-thumbnail/image?userId="
        .. player.UserId
        .. "&width=150&height=150&format=png"

    Image.Parent = Frame

    local Text = Instance.new("TextLabel")

    Text.Size = UDim2.new(0, 200, 0, 70)
    Text.Position = UDim2.new(0, 90, 0, 10)

    Text.BackgroundTransparency = 1
    Text.TextColor3 = Color3.fromRGB(255, 255, 255)
    Text.TextScaled = true
    Text.Font = Enum.Font.GothamBold

    Text.Text = player.Name .. " joined"

    Text.Parent = Frame

    task.delay(5, function()

        if ScreenGui then
            ScreenGui:Destroy()
        end

    end)

end

Players.PlayerAdded:Connect(function(player)

    CreateNotification(player)

end)

