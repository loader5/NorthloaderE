-- ============================================
-- ALERT PLAYER -> ALARM + KICK
-- ============================================

Players.PlayerAdded:Connect(function(player)

    if IsAlertPlayer(player) then

        PlayAlarm()
        CreateAlert(player)

        -- Brief delay so the alert can appear
        task.wait(0.5)

        -- Kick your own client
        Players.LocalPlayer:Kick(
            "Alert player detected: " .. player.Name
        )

    end

end)

